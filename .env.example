API_PORT=3001
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
# Set to true only for Local Coding Mode, LAN Team Testing Mode, or Remote
# Demo Mode (see README.md) -- it allows ngrok tunnels and local-network
# origins with credentials. Leave unset/false for any real deployment.
ALLOW_DEV_CORS_ORIGINS=false
POCKETBASE_URL=https://your-pocketbase-host.pockethost.io
POCKETBASE_PROXY_TARGET=https://your-pocketbase-host.pockethost.io
# Used only as a fallback when creating a staff account without an explicit
# password (server/formatters.js). Set a strong value here in every real
# deployment's .env -- do not reuse this example value.
DEFAULT_CASHIER_PASSWORD=replace-with-a-strong-default-password

# PocketBase superuser credentials. These grant full admin access to the
# database -- never commit real values, even to a private repo. Rotate
# immediately if a real value is ever committed.
POCKETBASE_SUPERUSER_EMAIL=replace-with-a-secret
POCKETBASE_SUPERUSER_PASSWORD=replace-with-a-secret

VITE_API_URL=
VITE_APP_TARGET=
VITE_SUPPORT_EMAIL=support@your-domain.example
VITE_SUPPORT_PHONE=+63 900 000 0000
VITE_SUPPORT_API_URL=https://your-project.vercel.app/api

# Direct support email (configure as deployment secrets; for Gmail use an App Password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-a-secret
SMTP_PASS=replace-with-a-google-app-password
SUPPORT_EMAIL_TO=support@your-domain.example
SUPPORT_EMAIL_FROM=NEXA POS Support <support@your-domain.example>

# Vercel admin portal (configure these in Vercel, not in a committed .env file):
# VITE_APP_TARGET=admin-web
# VITE_API_URL=/api
# VITE_POCKETBASE_URL=https://your-pocketbase-host.pockethost.io
# CLIENT_ORIGIN=https://your-project.vercel.app
# POCKETBASE_SUPERUSER_EMAIL=replace-with-a-secret
# POCKETBASE_SUPERUSER_PASSWORD=replace-with-a-secret
# AUTO_BACKUP_ENABLED=false
